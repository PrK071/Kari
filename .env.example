# Copie para `.env` (gitignored) e preencha.

# ---------------------------------------------------------------------------
# Runtime e ambiente do backend.
# Em producao, KARI_ALLOWED_ORIGINS e as duas URLs HTTPS sao obrigatorias.
# ---------------------------------------------------------------------------
KARI_ENV=development
KARI_RUNTIME=desktop
KARI_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
KARI_PERSISTENCE_BACKEND=json
DATABASE_URL=
KARI_SECRET_KEY=
KARI_SESSION_TTL_HOURS=720
KARI_RATE_LIMIT_BACKEND=memory
KARI_SCRAPER_MAX_CONCURRENCY=12
KARI_SCRAPER_MAX_PER_SOURCE=2
KARI_LOG_LEVEL=INFO
KARI_STORAGE_BACKEND=filesystem

# Carregado automaticamente pelo tools/sakura_requisitor.py (e manga_dataset)
# se python-dotenv estiver instalado.

# ---------------------------------------------------------------------------
# Proxy do Sakura (browser + solver + HTTP usam o MESMO IP).
# ---------------------------------------------------------------------------
# Formatos aceitos:
#   http://usuario:senha@host:porta      (HTTP/HTTPS com auth)
#   socks5://usuario:senha@host:porta    (SOCKS5; obs: Chromium nao faz auth SOCKS)
#   host:porta                           (sem auth)
#   host:porta:usuario:senha             (atalho com auth)
#
# IMPORTANTE p/ furar o Cloudflare 1020:
#   - Use proxy RESIDENCIAL ou MOVEL. Datacenter (AWS/OVH/etc.) costuma ja vir
#     bloqueado pelo Cloudflare.
#   - O cf_clearance fica preso ao IP. Prefira IP "sticky"/sessao (mesmo IP por
#     alguns minutos), nao rotativo a cada request.
SAKURA_PROXY=

# ---------------------------------------------------------------------------
# Resolucao automatica de captcha (opcional). Sem isto, o Cloudflare e
# resolvido manualmente na janela do navegador.
# ---------------------------------------------------------------------------
# CapSolver (suporta cf_clearance via AntiCloudflareTask -> melhor p/ o 1020).
CAPSOLVER_API_KEY=

# 2captcha (apenas token Turnstile; nao resolve cf_clearance).
TWOCAPTCHA_API_KEY=

# A origem atual e HTTP e, por isso, MangaGeek fica desabilitado no runtime web.
# Somente configure uma origem HTTPS depois de validar o endpoint oficialmente.
MANGAGEEK_API_BASE=http://geekstations.com.br/api/v2



# ---------------------------------------------------------------------------
# Vinculo de contas externas no perfil (OAuth2). Opcional.
# Sem credenciais, o botao "Vincular" aparece desabilitado no app.
# ---------------------------------------------------------------------------
# URLs base (mude so se rodar em host/porta diferente). O redirect_uri usado no
# cadastro dos apps abaixo e: <KARI_BACKEND_URL>/api/oauth/<provider>/callback
KARI_BACKEND_URL=http://127.0.0.1:8000
KARI_FRONTEND_URL=http://127.0.0.1:5173

# AniList -> https://anilist.co/settings/developer (crie um client)
#   Redirect URL: http://127.0.0.1:8000/api/oauth/anilist/callback
ANILIST_CLIENT_ID=
ANILIST_CLIENT_SECRET=

# MyAnimeList -> https://myanimelist.net/apiconfig
#   App Type: web / Redirect URL: http://127.0.0.1:8000/api/oauth/myanimelist/callback
#   MAL_CLIENT_SECRET so e necessario p/ apps do tipo "web" (deixe vazio p/ app publico).
MAL_CLIENT_ID=
MAL_CLIENT_SECRET=


# Discord como metodo de LOGIN/CADASTRO no app.
# https://discord.com/developers/applications -> New Application -> OAuth2
#   Redirect: http://127.0.0.1:8000/api/auth/discord/callback
#   Scopes usados: identify, email
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Google como metodo de LOGIN/CADASTRO no app.
# Google Cloud Console -> APIs e servicos -> Credenciais -> ID do cliente OAuth (Web).
#   Origem JavaScript autorizada: http://127.0.0.1:5173
#   URI de redirecionamento: http://127.0.0.1:8000/api/auth/google/callback
#   Scopes usados: openid, email, profile
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
